# ==================================================
# Nezha Server 基础配置
# ==================================================

# Web 服务对外监听端口
# 对应 docker-compose 中的 "8008:8008"
NEZHA_HTTP_PORT=8008


# ==================================================
# 数据库配置（外置 MariaDB / MySQL）
# ==================================================

# 数据库类型
# 固定为 mysql（兼容 MariaDB）
NEZHA_DB_TYPE=mysql

# 数据库主机地址
# 示例：127.0.0.1 / mariadb / db.example.com
NEZHA_DB_HOST=mariadb

# 数据库端口
NEZHA_DB_PORT=3306

# 逻辑数据库名称
# 语义要求：
# - 一应用一逻辑数据库
# - 不与其他 Stack 共享
# - 与 Stack 名保持一致
NEZHA_DB_NAME=nezha

# 数据库用户名
NEZHA_DB_USER=nezha

# 数据库密码
NEZHA_DB_PASSWORD=change_me

# 数据库字符集
# 推荐使用 utf8mb4
NEZHA_DB_CHARSET=utf8mb4

# 数据库时区
# 必须与数据库实例时区保持一致
NEZHA_DB_TIMEZONE=UTC
