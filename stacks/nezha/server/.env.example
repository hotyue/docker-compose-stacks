# ==================================================
# Nezha Server 基础配置
# ==================================================

# Web 服务对外监听端口
# 对应 docker-compose 中的 "8008:8008"
NEZHA_HTTP_PORT=8008


# ==================================================
# 数据库初始化阶段（仅用于 init 容器）
# ==================================================

# 必须是 已存在 的 MariaDB 管理账号
# 仅用于数据库与用户初始化
# 运行期严禁使用
NEZHA_DB_ADMIN_USER=db_admin
NEZHA_DB_ADMIN_PASSWORD=change_me_strong_admin_password


# ==================================================
# 数据库配置（外置 MariaDB / MySQL）
# ==================================================

# 数据库类型
# 固定为 mysql（兼容 MariaDB）
NEZHA_DB_TYPE=mysql

# 数据库主机地址（资源级）
# 示例：
# - mariadb
# - 127.0.0.1
# - db.example.com
NEZHA_DB_HOST=mariadb

# 数据库端口（资源级）
NEZHA_DB_PORT=3306

# ==================================================
# Nezha Server 逻辑数据库（运行期最小权限）
# ==================================================

# 逻辑数据库名称
# 语义约束：
# - 一 Stack 一逻辑数据库
# - 不与其他 Stack 共享
# - 仅供 Nezha Server 使用
NEZHA_DB_NAME=nezha

# 数据库用户名
# 必须为 Nezha Server 专属账号
NEZHA_DB_USER=nezha

# 数据库密码
# 仅用于运行期最小权限访问
NEZHA_DB_PASSWORD=change_me_strong_nezha_password

# 数据库字符集
# 推荐 utf8mb4
NEZHA_DB_CHARSET=utf8mb4

# 数据库时区
# 必须与数据库实例时区保持一致
NEZHA_DB_TIMEZONE=UTC


# ==================================================
# 时区配置
# ==================================================

# 容器运行时区
TZ=Asia/Shanghai
