# ==============================
# Nezha 初始化专用（Init 容器）
# ==============================

# 仅用于初始化阶段
# 必须是已存在的 MariaDB 管理账号（对应 MariaDB Stack 中的 DB_ADMIN_USER）
NEZHA_DB_ADMIN_USER=db_admin
NEZHA_DB_ADMIN_PASSWORD=change_me_strong_admin_password


# ==============================
# Nezha 基础配置
# ==============================

# Nezha 官方镜像
NEZHA_IMAGE=ghcr.io/nezhahq/nezha:latest

# 容器名称
NEZHA_CONTAINER_NAME=nezha-dashboard

# 对外暴露的 HTTP 端口 (面板访问)
NEZHA_HTTP_PORT=8008

# 对外暴露的 gRPC 端口 (Agent 通信)
# 必须暴露给被监控端连接
NEZHA_GRPC_PORT=5555


# ==============================
# 数据库配置（逻辑数据库语义）
# ==============================

# 数据库主机地址
# 说明：
# - 数据库实例属于平台级资源
# - 本 Stack 不负责数据库的创建、管理或校验
NEZHA_DB_HOST=mariadb

# 数据库端口
NEZHA_DB_PORT=3306

# 逻辑数据库名称
# 语义约束：
# - 建议等于 Stack 名：nezha
# - 该数据库仅供 Nezha 使用
NEZHA_DB_NAME=nezha

# 数据库用户名
# 建议使用与数据库同名的独立用户
NEZHA_DB_USER=nezha

# 数据库密码
NEZHA_DB_PASSWORD=change_me_strong_nezha_password


# ==============================
# GitHub/Gitee 登录配置 (必需)
# ==============================
# 哪吒监控强制要求配置 OAuth 登录管理员后台
# 请在 GitHub/Gitee 开发者设置中获取

# 示例：GitHub OAuth Client ID
NEZHA_OAUTH_CLIENT_ID=

# 示例：GitHub OAuth Client Secret
NEZHA_OAUTH_CLIENT_SECRET=


# ==============================
# 时区配置
# ==============================

TZ=Asia/Shanghai