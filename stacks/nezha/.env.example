# ==============================
# 哪吒监控 (Nezha) 配置参数
# ==============================

# 面板访问端口 (HTTP & Agent WebSocket)
# 默认: 8008
NEZHA_HTTP_PORT=8008

# ==============================
# OAuth 登录配置 (可选)
# ==============================
# 必需，否则无法进入后台
NEZHA_OAUTH_CLIENT_ID=
NEZHA_OAUTH_CLIENT_SECRET=

# ==============================
# 系统环境
# ==============================
TZ=Asia/Shanghai