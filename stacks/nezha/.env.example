# ==============================
# 哪吒监控 (Nezha) 配置参数
# ==============================

# 面板访问端口 (HTTP)
# 默认: 8008
NEZHA_HTTP_PORT=8008

# Agent 通信端口 (gRPC)
# 默认: 5555
NEZHA_GRPC_PORT=5555

# ==============================
# OAuth 登录配置 (可选)
# ==============================
# 如果不配置，后台可能无法登录，建议在安装后填写
NEZHA_OAUTH_CLIENT_ID=
NEZHA_OAUTH_CLIENT_SECRET=

# ==============================
# 系统环境
# ==============================
TZ=Asia/Shanghai