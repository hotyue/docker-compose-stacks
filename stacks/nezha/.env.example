# ==============================
# 哪吒监控 (Nezha) 配置参数
# ==============================

# 面板访问端口 (HTTP & Agent WebSocket)
NEZHA_HTTP_PORT=8008

# 站点名称 (仅在首次部署初始化时生效)
# 示例: 我的监控, Cloud Monitor
NEZHA_SITE_NAME=Nezha Monitoring

# ==============================
# OAuth 登录配置 (必需)
# ==============================
# 必需配置，否则无法进入后台
NEZHA_OAUTH_CLIENT_ID=
NEZHA_OAUTH_CLIENT_SECRET=

# ==============================
# 系统环境
# ==============================
TZ=Asia/Shanghai