# -------------------------------------------------------------------
# 基础
# -------------------------------------------------------------------
TZ=UTC

# -------------------------------------------------------------------
# 平台 MariaDB 连接（平台级数据库服务）
# -------------------------------------------------------------------
# Docker / Compose 网络中的服务名
MARIADB_HOST=mariadb
MARIADB_PORT=3306

# 平台级数据库管理员账号
# 仅用于 init 阶段创建逻辑数据库与专属用户
DB_ADMIN_USER=db_admin
DB_ADMIN_PASSWORD=change_me_strong_admin_password

# -------------------------------------------------------------------
# Traccar 专用数据库（运行期使用）
# -------------------------------------------------------------------
TRACCAR_DB_NAME=traccar
TRACCAR_DB_USER=traccar
TRACCAR_DB_PASSWORD=change_me_strong_traccar_password

# JDBC 连接串
# 吸收已验证生产实例参数，适配 MariaDB 11 / MySQL Connector-J
TRACCAR_DATABASE_URL=jdbc:mysql://mariadb:3306/traccar?zeroDateTimeBehavior=round&serverTimezone=UTC&allowPublicKeyRetrieval=true&useSSL=false&allowMultiQueries=true&autoReconnect=true&useUnicode=yes&characterEncoding=UTF-8&sessionVariables=sql_mode=''

# -------------------------------------------------------------------
# Traccar 服务端口
# -------------------------------------------------------------------
# Web 管理界面端口
TRACCAR_WEB_PORT=8082

# 设备接入端口段（TCP / UDP）
TRACCAR_DEVICE_PORT_RANGE=5000-5300
