# ==================================================
# phpMyAdmin 基础配置
# ==================================================
TZ=Asia/Shanghai

PMA_HOST=mariadb
PMA_PORT=3306

# 默认管理账号（平台级）
PMA_USER=db_admin

# 🌟 建议在 .env.example 中通过注释提醒用户
# 如果密码包含 $ 等特殊符号，建议使用单引号包裹，例如 '8X#gq$92qqL'
PMA_PASSWORD=change_me_strong_admin_password

PMA_ARBITRARY=0