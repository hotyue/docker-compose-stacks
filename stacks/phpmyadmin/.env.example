# ==================================================
# phpMyAdmin 基础配置
# ==================================================

# 目标数据库主机地址
# 示例：
#   mariadb
#   127.0.0.1
#   db.example.com
PMA_HOST=mariadb

# 数据库端口（MariaDB / MySQL）
# 通常为 3306
PMA_PORT=3306

# 登录数据库的用户名
PMA_USER=root

# 登录数据库的密码
PMA_PASSWORD=change_me_strong_app_password

# ==================================================
# phpMyAdmin 可选行为控制（建议保持默认）
# ==================================================

# 是否允许任意服务器登录（安全起见，保持关闭）
# 0 = 关闭（推荐）
# 1 = 开启
PMA_ARBITRARY=0
