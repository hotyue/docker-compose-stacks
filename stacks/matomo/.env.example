# ========== Matomo 基础配置 ==========
# Matomo 官方镜像
MATOMO_IMAGE=matomo:latest

# 容器名称
MATOMO_CONTAINER_NAME=matomo

# 对外暴露的 HTTP 端口
MATOMO_HTTP_PORT=8088

# Matomo 对外访问的基础 URL（必须）
# 用于后台归档任务（core:archive）
# 示例：
#   https://analytics.example.com
#   http://example.com/matomo
MATOMO_BASE_URL=http://localhost:8088

# ========== 数据库配置 ==========
# Matomo 使用的 MySQL / MariaDB 数据库
MATOMO_DB_HOST=mariadb
MATOMO_DB_NAME=matomo
MATOMO_DB_USER=matomo
MATOMO_DB_PASSWORD=change_me
MATOMO_DB_PREFIX=matomo_

# ========== 时区 ==========
TZ=Asia/Shanghai
