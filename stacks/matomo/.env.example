# ==============================
# Matomo 基础配置
# ==============================

# Matomo 官方镜像
MATOMO_IMAGE=matomo:latest

# 容器名称
MATOMO_CONTAINER_NAME=matomo

# 对外暴露的 HTTP 端口
MATOMO_HTTP_PORT=8088

# Matomo 对外访问的基础 URL（必须）
# 用于后台归档任务（core:archive）
#
# 示例：
#   https://analytics.example.com
#   http://example.com/matomo
#
# 如果你采用本项目构建的平台体系：
# - MariaDB 作为平台级数据库
# - Nginx Proxy Manager 反向代理 Matomo
#
# 此处应填写 Matomo 的「最终外部访问地址」
MATOMO_BASE_URL=http://localhost:8088


# ==============================
# 数据库配置（逻辑数据库语义）
# ==============================

# 数据库主机地址
# 说明：
# - 数据库实例属于平台级资源
# - 本 Stack 不负责数据库的创建、管理或校验
MATOMO_DB_HOST=mariadb

# 数据库端口
MATOMO_DB_PORT=3306

# 逻辑数据库名称
# 语义约束（v1.1.0 起明确）：
# - 必须等于 Stack 名：matomo
# - 该数据库仅供 Matomo 使用
MATOMO_DB_NAME=matomo

# 数据库用户名
# 建议使用与数据库同名的独立用户
MATOMO_DB_USER=matomo

# 数据库密码
# 需确保数据库与用户已预先存在
MATOMO_DB_PASSWORD=change_me_strong_matomo_password

# 表前缀
# 用于同一数据库实例中区分不同应用的数据表
MATOMO_DB_PREFIX=matomo_


# ==============================
# 时区配置
# ==============================

TZ=Asia/Shanghai
