# ==============================
# WordPress 初始化专用（v1.1.10）
# ==============================

# 仅用于初始化阶段
# 必须是已存在的 MariaDB 管理账号
WP_DB_ADMIN_USER=db_admin
WP_DB_ADMIN_PASSWORD=change_me_strong_admin_password


# ==============================
# WordPress 基础配置
# ==============================

# 官方镜像
WP_IMAGE=wordpress:latest

# 容器名称
WP_CONTAINER_NAME=wordpress

# 对外暴露端口
WP_HTTP_PORT=8028


# ==============================
# 数据库配置（逻辑数据库语义）
# ==============================

# 数据库主机地址
# - 数据库实例属于平台级资源
# - 本 Stack 不负责数据库服务的创建或管理
WP_DB_HOST=mariadb

# 数据库端口
WP_DB_PORT=3306

# 逻辑数据库名称
# 语义约束：
# - 一个 Stack 对应一个逻辑数据库
# - 该数据库仅供 WordPress 使用
WP_DB_NAME=wordpress

# 数据库用户名
# 建议使用与数据库逻辑名强关联的独立用户
WP_DB_USER=wp

# 数据库密码
WP_DB_PASSWORD=change_me_strong_wp_password


# ==============================
# 时区配置
# ==============================

TZ=Asia/Shanghai
