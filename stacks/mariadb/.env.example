# MariaDB runtime environment
# 首次部署时会复制到 /opt/docker/mariadb/.env
# ⚠️ 仅在数据目录为空时生效，初始化完成后不再执行

# -------------------------------------------------------------------
# 基础运行环境
# -------------------------------------------------------------------
TZ=UTC

# 端口映射（宿主机端口:容器 3306）
MARIADB_PORT=3306

# -------------------------------------------------------------------
# Root 账号（仅用于初始化 / 紧急维护）
# -------------------------------------------------------------------
# ⚠️ 不用于日常数据库管理
MARIADB_ROOT_PASSWORD=change_me_strong_root_password
MARIADB_ROOT_HOST=localhost

# -------------------------------------------------------------------
# 示例：初始化业务数据库（可选）
# 仅用于示例与兼容，不属于平台治理范畴
# -------------------------------------------------------------------
MARIADB_DATABASE=app
MARIADB_USER=app
MARIADB_PASSWORD=change_me_strong_app_password

# -------------------------------------------------------------------
# v1.1.6 平台级账号治理（仅首次初始化生效）
# -------------------------------------------------------------------

# 平台级数据库管理员账号
# 用于 DBA / 运维 / phpMyAdmin 管理
DB_ADMIN_USER=db_admin
DB_ADMIN_PASSWORD=change_me_strong_admin_password

# 平台级只读账号
# 用于审计 / 查询 / 监控
DB_READONLY_USER=db_readonly
DB_READONLY_PASSWORD=change_me_strong_readonly_password
