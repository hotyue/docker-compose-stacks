# ==============================
# Nginx Proxy Manager 初始化专用（v1.1.8）
# ==============================

# 仅用于初始化阶段
# 必须是已存在的 MariaDB 管理账号
NPM_DB_ADMIN_USER=db_admin
NPM_DB_ADMIN_PASSWORD=change_me_strong_admin_password


# ==============================
# Nginx Proxy Manager 基础配置
# ==============================

# 官方镜像
NPM_IMAGE=jc21/nginx-proxy-manager:latest

# 容器名称
NPM_CONTAINER_NAME=nginx-proxy-manager

# 对外暴露端口
# HTTP
NPM_HTTP_PORT=80

# 管理界面
NPM_ADMIN_PORT=81

# HTTPS
NPM_HTTPS_PORT=443


# ==============================
# 数据库配置（逻辑数据库语义）
# ==============================

# 数据库主机地址
# 说明：
# - 数据库实例属于平台级资源
# - 本 Stack 不负责数据库服务的创建或管理
NPM_DB_HOST=mariadb

# 数据库端口
NPM_DB_PORT=3306

# 逻辑数据库名称
# 语义约束（与 Matomo 同构）：
# - 一个 Stack 对应一个逻辑数据库
# - 该数据库仅供 Nginx Proxy Manager 使用
NPM_DB_NAME=nginx_proxy_manager

# 数据库用户名
# 建议使用与数据库逻辑名强关联的独立用户
NPM_DB_USER=npm

# 数据库密码
NPM_DB_PASSWORD=change_me_strong_npm_password


# ==============================
# 时区配置
# ==============================

TZ=Asia/Shanghai
