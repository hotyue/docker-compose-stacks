# ==============================
# Vaultwarden 初始化专用（v1.1.12）
# ==============================

# 仅用于初始化阶段
# 必须是已存在的 MariaDB 管理账号（平台级 MariaDB）
VAULTWARDEN_DB_ADMIN_USER=db_admin
VAULTWARDEN_DB_ADMIN_PASSWORD=change_me_strong_admin_password


# ==============================
# Vaultwarden 基础配置
# ==============================

# Vaultwarden 官方镜像（社区维护的 Bitwarden 兼容服务端）
VAULTWARDEN_IMAGE=vaultwarden/server:latest

# 容器名称
VAULTWARDEN_CONTAINER_NAME=vaultwarden

# ==============================
# 端口语义说明（非常重要）
# ==============================
#
# - Vaultwarden 容器内部端口：官方默认 80（不配置、不覆盖）
# - 下方端口仅用于“宿主机映射 / IP 直连调试”
# - Nginx Proxy Manager 反代时：
#   Forward Hostname = vaultwarden
#   Forward Port     = 80
#
# 若不需要 IP:端口 直连，可在 docker-compose 中直接移除 ports 映射
#
VAULTWARDEN_HTTP_PORT=8038


# ==============================
# Vaultwarden 对外访问地址
# ==============================

# 必须与浏览器实际访问地址完全一致（一字不差）
# 必须是 https://
#
# 示例：
#   https://vault.example.com
#
# 注意：
# - HTTPS 由 Nginx Proxy Manager 终止
# - Cloudflare 橙云 / Zero Trust Tunnel 场景同样填写最终外部地址
#
VAULTWARDEN_DOMAIN=https://vault.example.com


# ==============================
# 数据库配置（逻辑数据库语义）
# ==============================

# 数据库主机地址（平台级）
VAULTWARDEN_DB_HOST=mariadb

# 数据库端口
VAULTWARDEN_DB_PORT=3306

# 逻辑数据库名称
# 语义约束（延续本仓库治理风格）：
# - 建议等于 Stack 名：vaultwarden
# - 该数据库仅供 Vaultwarden 使用
VAULTWARDEN_DB_NAME=vaultwarden

# 数据库用户名（专用、最小权限）
VAULTWARDEN_DB_USER=vaultwarden

# 数据库密码（必须修改）
VAULTWARDEN_DB_PASSWORD=change_me_strong_vaultwarden_password


# ==============================
# 可选治理项（按需启用）
# ==============================

# 管理员面板 Token（强烈建议设置为高强度随机值）
# VAULTWARDEN_ADMIN_TOKEN=change_me_strong_admin_token

# 是否允许注册（建议生产环境关闭）
# VAULTWARDEN_SIGNUPS_ALLOWED=false


# ==============================
# 时区配置
# ==============================
TZ=Asia/Shanghai
